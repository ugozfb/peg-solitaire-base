# Aktif chain seçimi: "base" -> mainnet, aksi halde (default) baseSepolia.
NEXT_PUBLIC_CHAIN=

# Kontrat adresi (deploy edilen network'e göre değişir).
NEXT_PUBLIC_CONTRACT_ADDRESS=

# ERC-8021 builder code (Base builder rewards attribution).
# base.dev kaydı sonrası doldurulacak. BOŞKEN attribution eklenmez,
# unlockBoard transaction'ı normal çalışır.
NEXT_PUBLIC_BUILDER_CODE=
